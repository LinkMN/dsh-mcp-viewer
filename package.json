{
  "name": "dsh-mcp-viewer",
  "version": "0.1.0",
  "description": "DSH 的 MCP 面板：列出已配置的 MCP 服务器与其实际注册的工具，带服务器与工具级开关、重新连接、删除。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkMN/dsh-mcp-viewer.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
